# Set these in your shell (or your deployment environment).
MAX_CONCURRENT_CONVERSIONS=2
CONVERSION_TIMEOUT_SECONDS=600
MAX_DURATION_SECONDS=1800
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Combined source downloads and final media, in MiB.
MAX_DOWNLOAD_MB=512
MAX_OUTPUT_MB=512

# Persistent single-host job queue and completed files.
# JOB_DATA_DIR=/absolute/path/to/media-jobs
JOB_RETENTION_SECONDS=3600
MAX_STORED_JOBS=20
